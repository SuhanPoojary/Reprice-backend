# Backend env (examples)
PORT=3001
NODE_ENV=development

# DB
DATABASE_URL=postgresql://...

# Optional: auto-create/alter admin-related tables/indexes at runtime.
# Enabled by default (backward-compatible). Disable in production to avoid DDL load.
# DB_AUTO_MIGRATE=false

# Optional: tiny in-memory cache (ms) for admin-heavy endpoints (dashboard stats, pending partners, partner verification details)
# ADMIN_API_CACHE_TTL_MS=10000

# JWT
JWT_SECRET=change-me

# Vector search backend (FastAPI / Pinecone). Used by admin phone editor.
# Local example: http://localhost:8000
# Deployed example: https://reprice-ml-backend.onrender.com
VECTOR_BACKEND_URL=https://reprice-ml-backend.onrender.com
# Serviceability settings
# Allow orders if any approved partner is within this km radius of the customer's PIN.
SERVICE_RADIUS_KM=20

# Nominatim (OpenStreetMap) geocoding settings
# Nominatim requires an identifying User-Agent.
# Example: MobileTrade/1.0 (contact: you@example.com)
NOMINATIM_USER_AGENT=MobileTrade/1.0 (contact: you@example.com)

# Admin portal secret mount path (admin UI served here in production)
ADMIN_PORTAL_PATH=/__admin_portal_93c2f7

# Admin credentials (pick ONE of password or password hash)
ADMIN_EMAIL=admin@reprice.local
ADMIN_FULL_NAME=Admin
ADMIN_ROLE=super_admin
# ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=$2a$10$...
