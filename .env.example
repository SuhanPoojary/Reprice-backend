# Backend env (examples)
PORT=3001
NODE_ENV=development

# DB
DATABASE_URL=postgresql://...

# Optional: auto-create/alter admin-related tables/indexes at runtime.
# Enabled by default (backward-compatible). Disable in production to avoid DDL load.
# DB_AUTO_MIGRATE=false

# Optional: tiny in-memory cache (ms) for admin-heavy endpoints (dashboard stats, pending partners, partner verification details)
# ADMIN_API_CACHE_TTL_MS=10000

# JWT
JWT_SECRET=change-me

# Vector search backend (FastAPI / Pinecone). Used by admin phone editor.
# Local example: http://localhost:8000
# Deployed example: https://reprice-ml-backend.onrender.com
VECTOR_BACKEND_URL=https://reprice-ml-backend.onrender.com
# Serviceability settings
# Allow orders if any approved partner is within this km radius of the customer's PIN.
SERVICE_RADIUS_KM=20

# Nominatim (OpenStreetMap) geocoding settings
# Nominatim requires an identifying User-Agent.
# Example: MobileTrade/1.0 (contact: you@example.com)
NOMINATIM_USER_AGENT=MobileTrade/1.0 (contact: you@example.com)

# geocode.maps.co (address -> latitude/longitude for customer order addresses)
# Create a key at https://geocode.maps.co/join/
GEOCODE_MAPS_CO_API_KEY=change-me
# Optional identifying User-Agent; falls back to a default if unset.
# GEOCODE_MAPS_CO_USER_AGENT=MobileTrade/1.0 (contact: you@example.com)

# Admin portal secret mount path (admin UI served here in production)
ADMIN_PORTAL_PATH=/__admin_portal_93c2f7

# Admin credentials (pick ONE of password or password hash)
ADMIN_EMAIL=admin@reprice.local
ADMIN_FULL_NAME=Admin
ADMIN_ROLE=super_admin
# ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=$2a$10$...

# =========================
# Debugging / logging
# =========================
# Log the start of each HTTP request
# LOG_HTTP_START=true
# Log every HTTP request completion (otherwise only slow ones)
# LOG_HTTP_ALL=false
# Warn+log any request slower than this (ms)
# SLOW_REQ_MS=2000

# =========================
# Email (SMTP) + verification
# =========================
# EMAIL_DISABLED=true  # skips sending email (useful to isolate production slowness)
# EMAIL_DEBUG=true     # logs transporter config + send attempts

# NOTE: For now, partner OTP is returned in the signup response and logged on the server.
# Remove this behavior once email delivery is fixed.

# Provider selection:
# - EMAIL_PROVIDER=smtp   (default if unset)
# - EMAIL_PROVIDER=brevo  (recommended on Render; free tier)
# - EMAIL_PROVIDER=resend
# EMAIL_PROVIDER=brevo

# Provider-agnostic sender:
# EMAIL_FROM="MobileTrade <no-reply@yourdomain.com>"  # or just no-reply@yourdomain.com
# EMAIL_FROM_NAME=MobileTrade

# Brevo (free tier ~300 emails/day). Create an API key in Brevo and verify sender.
# BREVO_API_KEY=...

# Resend (free tier available; usually requires domain verification for best deliverability)
# RESEND_API_KEY=...

# HTTP email timeouts (ms)
# EMAIL_HTTP_TIMEOUT_MS=15000

# SMTP timeouts (prevents hanging when SMTP is blocked/slow)
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=20000
